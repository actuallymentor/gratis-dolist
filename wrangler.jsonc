// Cloudflare Worker: static assets only for now (the PWA in apps/web).
// Deployed exclusively by .github/workflows/deploy.yml; add D1/KV bindings when sync lands.
{
  "name": "dolist",
  "compatibility_date": "2026-11-01",

  // Output of `npm run build`
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "single-page-application"
  },

  // First deploy creates the DNS record + cert for this custom domain
  "routes": [
    { "pattern": "dolist.gratis.sh", "custom_domain": true }
  ],

  // Serve only the custom domain, not dolist.<account>.workers.dev
  "workers_dev": false
}
